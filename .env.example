AUTH_SECRET=change-me-to-a-long-random-string-32chars-min
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: leave empty — the app uses zero-setup JSON files in ./data/.
# Production (Netlify/Vercel): paste a Postgres URL. Free option:
#   1. Create a project at neon.tech (or supabase.com → Connect → URI)
#   2. npx prisma migrate deploy  (run once, with this URL set locally)
#   3. Add the same DATABASE_URL in your host's environment variables
# DATABASE_URL=postgresql://user:password@ep-xyz-123.us-east-2.aws.neon.tech/neondb?sslmode=require
